<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>나만의 단어장 앱</title>
    <style>
        body {
            font-family: 'Arial', sans-serif;
            background-color: #f4f7f6;
            color: #333;
            margin: 0;
            padding: 20px;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        h1 {
            color: #6b5b95;
            margin-bottom: 30px;
        }

        /* 입력 및 추가 섹션 */
        .input-section {
            background-color: #ffffff;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            margin-bottom: 30px;
            width: 100%;
            max-width: 500px;
        }

        .input-section input {
            width: calc(50% - 10px); /* 두 개의 입력 필드를 한 줄에 배치 */
            padding: 10px;
            margin-bottom: 10px;
            border: 1px solid #ccc;
            border-radius: 5px;
            box-sizing: border-box;
        }

        .input-section button {
            width: 100%;
            padding: 10px;
            background-color: #ff6f61;
            color: white;
            border: none;
            border-radius: 5px;
            font-size: 1.1em;
            cursor: pointer;
            transition: background-color 0.2s;
        }

        .input-section button:hover {
            background-color: #e55c50;
        }

        /* 플래시 카드 섹션 */
        .card-section {
            margin-bottom: 30px;
            text-align: center;
        }
        
        #flashCard {
            width: 300px;
            height: 150px;
            background-color: #6b5b95;
            color: white;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 1.5em;
            font-weight: bold;
            border-radius: 10px;
            box-shadow: 0 6px 12px rgba(0, 0, 0, 0.2);
            cursor: pointer;
            margin-bottom: 15px;
            transition: transform 0.3s, background-color 0.3s;
            perspective: 1000px; /* 3D 효과를 위한 원근법 */
            user-select: none;
        }

        #flashCard.is-flipped {
            transform: rotateY(180deg);
        }
        
        #cardContent {
            transition: transform 0.3s;
            transform-style: preserve-3d;
        }

        .card-controls button {
            padding: 8px 15px;
            margin: 0 5px;
            background-color: #009688;
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
        }

        /* 단어 목록 섹션 */
        .list-section {
            width: 100%;
            max-width: 500px;
            background-color: #ffffff;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }

        #wordList {
            list-style: none;
            padding: 0;
        }

        #wordList li {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 8px 0;
            border-bottom: 1px solid #eee;
            font-size: 1.1em;
        }

        #wordList li:last-child {
            border-bottom: none;
        }

        #wordList li .delete-btn {
            background-color: #ccc;
            color: #333;
            border: none;
            padding: 5px 10px;
            border-radius: 5px;
            cursor: pointer;
            font-size: 0.8em;
            transition: background-color 0.2s;
        }
        #wordList li .delete-btn:hover {
            background-color: #ff6f61;
            color: white;
        }
    </style>
</head>
<body>

    <h1>📝 나만의 단어장</h1>

    <div class="input-section">
        <input type="text" id="wordInput" placeholder="단어 (예: Apple)">
        <input type="text" id="meaningInput" placeholder="뜻 (예: 사과)">
        <button onclick="addWord()">단어 추가</button>
    </div>
    
    <div class="card-section">
        <h2>✨ 플래시 카드 학습</h2>
        <div id="flashCard" onclick="flipCard()">
            <span id="cardContent">단어를 추가해 보세요!</span>
        </div>
        <div class="card-controls">
            <button onclick="prevWord()">이전 단어</button>
            <button onclick="nextWord()">다음 단어</button>
        </div>
    </div>

    <div class="list-section">
        <h2>📋 단어 목록</h2>
        <ul id="wordList">
            </ul>
    </div>

    <script>
        // 단어 데이터를 저장할 배열
        let words = JSON.parse(localStorage.getItem('myWords')) || []; 
        let currentWordIndex = 0;
        let isMeaningShown = false;

        // 시작 시 저장된 단어를 불러와 화면에 표시
        document.addEventListener('DOMContentLoaded', () => {
            renderWordList();
            updateFlashCard();
        });

        // 로컬 저장소에 단어 배열 저장
        function saveWords() {
            localStorage.setItem('myWords', JSON.stringify(words));
        }

        // 1. 단어 추가 기능
        function addWord() {
            const wordInput = document.getElementById('wordInput');
            const meaningInput = document.getElementById('meaningInput');
            
            const word = wordInput.value.trim();
            const meaning = meaningInput.value.trim();

            if (word === "" || meaning === "") {
                alert("단어와 뜻을 모두 입력해주세요!");
                return;
            }

            words.push({ word, meaning });
            saveWords(); // 저장
            
            wordInput.value = "";
            meaningInput.value = "";

            renderWordList();
            
            // 새 단어를 추가하면 플래시 카드를 새 단어로 업데이트
            if (words.length === 1) {
                currentWordIndex = 0;
                updateFlashCard();
            }
        }

        // 2. 단어 목록 화면에 그리기
        function renderWordList() {
            const listElement = document.getElementById('wordList');
            listElement.innerHTML = ''; // 목록 초기화

            words.forEach((item, index) => {
                const li = document.createElement('li');
                li.innerHTML = `
                    <span>${item.word} - ${item.meaning}</span>
                    <button class="delete-btn" onclick="deleteWord(${index})">삭제</button>
                `;
                listElement.appendChild(li);
            });
        }
        
        // 3. 단어 삭제 기능
        function deleteWord(index) {
            if (confirm(`${words[index].word}를 정말 삭제하시겠습니까?`)) {
                words.splice(index, 1);
                saveWords();

                // 현재 인덱스가 삭제된 항목이었고, 목록이 비어있지 않다면 인덱스 조정
                if (currentWordIndex >= words.length && words.length > 0) {
                    currentWordIndex = words.length - 1;
                } else if (words.length === 0) {
                    currentWordIndex = 0;
                }
                
                renderWordList();
                updateFlashCard();
            }
        }

        // 4. 플래시 카드 내용 업데이트
        function updateFlashCard() {
            const cardContent = document.getElementById('cardContent');
            const flashCard = document.getElementById('flashCard');
            
            if (words.length === 0) {
                cardContent.innerText = '단어를 추가해 보세요!';
                flashCard.style.backgroundColor = '#6b5b95'; // 기본색 유지
                isMeaningShown = false;
                return;
            }

            const currentWord = words[currentWordIndex];
            
            if (!isMeaningShown) {
                // 단어 보여주기
                cardContent.innerText = currentWord.word;
                flashCard.style.backgroundColor = '#6b5b95'; // 단어는 보라색
            } else {
                // 뜻 보여주기
                cardContent.innerText = currentWord.meaning;
                flashCard.style.backgroundColor = '#009688'; // 뜻은 청록색
            }
        }

        // 5. 카드 뒤집기 (단어 <-> 뜻)
        function flipCard() {
            if (words.length === 0) return;
            
            isMeaningShown = !isMeaningShown;
            updateFlashCard();
        }

        // 6. 다음 단어 보기
        function nextWord() {
            if (words.length === 0) return;
            
            currentWordIndex = (currentWordIndex + 1) % words.length;
            isMeaningShown = false; // 새 단어로 이동 시 초기 상태 (단어)로
            updateFlashCard();
        }

        // 7. 이전 단어 보기
        function prevWord() {
            if (words.length === 0) return;
            
            // 자바스크립트 모듈로 연산: (a - 1 + n) % n.
            currentWordIndex = (currentWordIndex - 1 + words.length) % words.length;
            isMeaningShown = false; // 새 단어로 이동 시 초기 상태 (단어)로
            updateFlashCard();
        }
    </script>
</body>
</html>
